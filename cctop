# ---------------------------------------------------------------- data

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


class AgentsUnavailable(Exception):
    pass


def agents():
    """Running sessions. Raises rather than returning [] on failure: an empty list would read as
    every session having ended, and get logged that way."""
    try:
        out = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True, timeout=10).stdout
        result = json.loads(out)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        raise AgentsUnavailable(str(e))
    if not isinstance(result, list):
        raise AgentsUnavailable("unexpected output from claude agents")
    return result


def transcript_path(session_id):
    hits = glob.glob(os.path.join(PROJECTS_DIR, "*", session_id + ".jsonl"))
    return max(hits, key=os.path.getmtime) if hits else None


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""


def parse_tail(path):
    """Pull the latest title/branch/PR/messages out of the end of a transcript."""
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - TAIL_BYTES))
        lines = f.read().decode("utf-8", "replace").splitlines()
    if size > TAIL_BYTES:
        lines = lines[1:]  # first line is probably cut off

    meta = {}
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        t = d.get("type")
        if t == "custom-title":
            meta.setdefault("customTitle", d.get("customTitle"))
        elif t == "ai-title":
            meta.setdefault("aiTitle", d.get("aiTitle"))
        elif t == "pr-link":
            meta.setdefault("pr", {"number": d.get("prNumber"), "url": d.get("prUrl")})
        elif t == "last-prompt":
            meta.setdefault("lastPrompt", d.get("lastPrompt"))
        elif t == "assistant" and "lastReply" not in meta:
            txt = text_of((d.get("message") or {}).get("content")).strip()
            if txt:
                meta["lastReply"] = txt
        if t == "user" and d.get("entrypoint"):
            meta.setdefault("entrypoint", d["entrypoint"])
            meta["prompts"] = max(meta.get("prompts", 0), (d.get("turnPosition") or {}).get("promptIndex") or 0)
        if d.get("cwd"):
            meta.setdefault("lastCwd", d["cwd"])
        if d.get("gitBranch"):
            meta.setdefault("branch", d["gitBranch"])
        if d.get("timestamp"):
            meta.setdefault("lastActivity", d["timestamp"])
    return meta


def meta_for_path(path, cache):
    st = os.stat(path)
    hit = cache.get(path)
    if hit and hit["mtime"] == st.st_mtime and hit["size"] == st.st_size:
        meta = hit["meta"]
    else:
        meta = parse_tail(path)
        cache[path] = {"mtime": st.st_mtime, "size": st.st_size, "meta": meta}
    return dict(meta, transcript=path, transcriptMtime=st.st_mtime)


def transcript_meta(session_id, cache):
    path = transcript_path(session_id)
    return meta_for_path(path, cache) if path else {}


# Recently ended sessions: interactive terminal conversations with a few prompts whose process is
# gone. Covers ^x, /exit, closed tabs and Warp restarts alike. Claude doesn't record when a session
# ended, so the view also tracks which Warp sessions are live (LIVE) and logs the ones that vanish
# (ENDED), grouped by the tick they vanished in; a group of several is a Warp quit or restart.
CLOSED_HOURS = 24
CLOSED_MAX = 8
CLOSED_MIN_PROMPTS = 2
DISMISSED = os.path.join(CACHE_DIR, "dismissed.json")
LIVE = os.path.join(CACHE_DIR, "live.json")
ENDED = os.path.join(CACHE_DIR, "ended.json")
TICK_GAP = 60  # longer between snapshots means the view wasn't running; times are then approximate


def closed_sessions(live_ids, cache):
    cutoff = time.time() - CLOSED_HOURS * 3600
    dismissed = set(load_json(DISMISSED, []))
    ended = load_json(ENDED, {})
    candidates = {}
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        if mtime >= cutoff:
            candidates[os.path.basename(path)[:-len(".jsonl")]] = path
    for sid in ended:
        candidates.setdefault(sid, transcript_path(sid))
    rows = []
    for sid, path in candidates.items():
        if not path or sid in live_ids or sid in dismissed:
            continue
        meta = meta_for_path(path, cache)
        tracked = ended.get(sid)
        if (meta.get("entrypoint") or "").startswith("sdk"):
            continue  # Agent SDK runs, even if an older view logged one
        if not tracked and (meta.get("entrypoint") != "cli" or meta.get("prompts", 0) < CLOSED_MIN_PROMPTS):
            continue
        rows.append(dict(meta, key="c:" + sid, kind="closed", sessionId=sid,
                         cwd=(tracked or {}).get("cwd") or meta.get("lastCwd") or HOME,
                         statusSince=(tracked or {}).get("at") or meta["transcriptMtime"]))
    rows.sort(key=lambda r: -r["statusSince"])
    return rows


GROUP_GAP = 30  # sessions ending within this many seconds of the previous one count as one group


def restore_groups(live_ids):
    """Every run of 2+ sessions that ended close together and aren't running again, newest first.

    Chaining by gap (rather than requiring the same tick) also catches tabs closed one by one, and
    covers every way a session ends (^x, /exit, closing the tab, Warp quitting). ENDED holds one
    entry per session (its latest ending), so a session can only ever be in one group.
    """
    dismissed = set(load_json(DISMISSED, []))
    ended = sorted((dict(e, sessionId=sid) for sid, e in load_json(ENDED, {}).items()
                    if sid not in live_ids and sid not in dismissed),
                   key=lambda e: e["at"])
    runs, current = [], []
    for e in ended:
        if current and e["at"] - current[-1]["at"] > GROUP_GAP:
            runs.append(current)
            current = []
        current.append(e)
    if current:
        runs.append(current)
    groups = []
    for members in reversed(runs):
        batch = members[0]["at"]
        if len(members) >= 2 and "batch:%r" % batch not in dismissed:
            members.sort(key=lambda m: (m.get("order") or [9999, 9999], m.get("title", "")))
            groups.append({"key": "batch:%r" % batch, "kind": "batch", "batch": batch, "members": members,
                           "name": "Reopen all %d sessions · closed at %s"
                                   % (len(members), time.strftime("%H:%M", time.localtime(batch))),
                           "statusSince": max(m["at"] for m in members), "cwd": ""})
    return groups


def closed_section(live_ids, cache):
    """Divider, then closed sessions newest first; each reopen-all group is one block, placed at
    the time its sessions closed, with its sessions nested under it."""
    closed = closed_sessions(live_ids, cache)
    by_sid = {r["sessionId"]: r for r in closed}
    blocks = []
    for group in restore_groups(live_ids):
        block = [group]
        for i, m in enumerate(group["members"]):
            row = by_sid.pop(m["sessionId"], None) or dict(
                m, key="c:" + m["sessionId"], kind="closed", statusSince=m["at"])
            row["tree"] = "└" if i == len(group["members"]) - 1 else "├"
            block.append(row)
        blocks.append(block)
    blocks += [[r] for r in closed if r["sessionId"] in by_sid][:CLOSED_MAX]
    blocks.sort(key=lambda block: -block[0]["statusSince"])
    rows = [row for block in blocks for row in block]
    return [{"key": "divider", "kind": "divider"}] + rows if rows else []


_uuid_by_pid = {}


def warp_tab_order(pids):
    """(window, tab) position per pid, from Warp's own state DB keyed by each tab's session uuid."""
    import sqlite3
    db = os.path.join(HOME, "Library/Group Containers/2BBY89MBSN.dev.warp/Library/Application Support",
                      "dev.warp.Warp-Stable/warp.sqlite")
    try:
        con = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=1)
        tabs = {u: [w, t] for u, w, t in con.execute(
            "select lower(hex(tp.uuid)), t.window_id, t.id from terminal_panes tp "
            "join pane_nodes pn on pn.id = tp.id join tabs t on t.id = pn.tab_id")}
        con.close()
    except Exception:
        return {}
    order = {}
    for pid in pids:
        if pid not in _uuid_by_pid:
            url = focus_url(pid) or ""
            _uuid_by_pid[pid] = url.rsplit("/", 1)[-1].lower()
        if _uuid_by_pid[pid] in tabs:
            order[pid] = tabs[_uuid_by_pid[pid]]
    return order


def track_ended(rows):
    if DEMO:
        return
    now = time.time()
    live = {r["sessionId"]: r for r in rows if r.get("kind") == "interactive" and r.get("host") == "warp"
            and r.get("sessionId")}
    prev = load_json(LIVE, {})
    ended = load_json(ENDED, {})
    gone = [sid for sid in prev.get("sessions", {}) if sid not in live]
    if gone:
        batch = now if now - prev.get("at", 0) < TICK_GAP else prev["at"]
        for sid in gone:
            ended.setdefault(sid, dict(prev["sessions"][sid], at=batch, batch=batch))
    for sid in live:
        ended.pop(sid, None)  # reopened
    ended = {k: v for k, v in ended.items() if now - v["at"] < CLOSED_HOURS * 3600}
    order = warp_tab_order([r["pid"] for r in live.values()])
    save_json(ENDED, ended)
    save_json(LIVE, {"at": now, "sessions": {sid: {"title": title(r), "cwd": r.get("cwd"),
                                                    "order": order.get(r["pid"])}
                                              for sid, r in live.items()}})



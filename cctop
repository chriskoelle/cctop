# Where an interactive session's process lives, judged from its own command line and ancestors.
HOSTS = (("--sdk-url", "remote"), ("/Claude.app/", "desktop"), ("/Obsidian.app/", "obsidian"),
         ("/Warp.app/", "warp"))


def processes():
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        pid, ppid, cmd = (line.split(None, 2) + [""])[:3]
        procs[pid] = (ppid, cmd)
    return procs


def host(pid, procs):
    pid, seen = str(pid), set()
    while pid in procs and pid not in seen and pid != "1":
        seen.add(pid)
        ppid, cmd = procs[pid]
        for needle, name in HOSTS:
            if needle in cmd:
                return name
        pid = ppid
    return "other"


def collect():
    if DEMO:
        return demo_rows()
    cache = load_json(META_CACHE, {})
    procs = processes()
    rows = []
    for a in agents():
        s = dict(a)
        s["key"] = str(a.get("pid") or a.get("id"))
        if a.get("kind") == "interactive" and a.get("pid"):
            sf = load_json(os.path.join(SESSIONS_DIR, "%s.json" % a["pid"]), {})
            s["nameSource"] = sf.get("nameSource")
            s["statusSince"] = (sf.get("statusUpdatedAt") or 0) / 1000 or None
            s["host"] = host(a["pid"], procs)
        if a.get("sessionId"):
            s.update(transcript_meta(a["sessionId"], cache))
        if not s.get("statusSince"):
            s["statusSince"] = s.get("transcriptMtime") or a.get("startedAt", 0) / 1000
        if (s.get("entrypoint") or "").startswith("sdk"):
            # Agent SDK runs (scripts, tests) aren't your sessions: shown as "sdk", never tracked
            # as closed, and hidden in Warp-only mode.
            s["host"] = "sdk"
        rows.append(s)
    rows += closed_section({r.get("sessionId") for r in rows}, cache)
    keep = {r.get("transcript") for r in rows if r.get("transcript")}
    save_json(META_CACHE, {k: v for k, v in cache.items() if k in keep or v["mtime"] > time.time() - CLOSED_HOURS * 3600})
    return rows


def title(s):
    if s.get("kind") == "batch":
        return s["name"]
    if s.get("nameSource") == "user" or (s.get("kind") == "background" and s.get("name")):
        return s.get("name")
    return s.get("customTitle") or s.get("aiTitle") or s.get("name") or s.get("title") or "?"


def where(s):
    cwd = s.get("cwd", "")
    if "/.claude/worktrees/" in cwd:
        repo, wt = cwd.split("/.claude/worktrees/", 1)
        return "%s ⎇ %s" % (os.path.basename(repo), wt.split("/")[0])
    return cwd.replace(HOME, "~")


# Idle sessions age through these buckets; a merged/closed PR marks a session "done" regardless.
WAITING_SECONDS = 2 * 3600
STALE_SECONDS = 2 * 86400

# state: (icon, color, sort rank)
STATES = {
    "needs you": ("⚠", YELLOW + BOLD, 0),
    "working": ("●", GREEN, 1),
    "waiting": ("◆", BOLD, 2),
    "idle": ("○", "", 3),
    "stale": ("·", DIM, 4),
    "done": ("✓", MAGENTA, 5),
    "reopen all": ("↺", DIM, 6),
    "closed": ("↺", DIM, 7),
}


def pr_info(s, prs):
    pr = s.get("pr")
    return prs.get(pr["url"], {}) if pr and pr.get("url") else {}


def state(s, prs=None):
    if s.get("kind") == "closed":
        return "closed"
    if s.get("kind") == "batch":
        return "reopen all"
    raw = s.get("status") or s.get("state") or "?"
    if raw == "busy" or raw == "running":
        return "working"
    if raw not in ("idle", "completed"):
        return "needs you"
    if pr_info(s, prs or pr_cache()).get("state") in ("MERGED", "CLOSED"):
        return "done"
    idle = time.time() - (s.get("statusSince") or time.time())
    return "waiting" if idle < WAITING_SECONDS else "idle" if idle < STALE_SECONDS else "stale"


def age(seconds):
    if seconds < 60:
        return "now"
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= n:
            return "%d%s" % (seconds // n, unit)


def pr_label(s, prs):
    """Plain text and color for the PR column, e.g. "#412 open ✓"."""
    pr = s.get("pr")
    if not pr or not pr.get("url"):
        return "", ""
    info = pr_info(s, prs)
    st = info.get("state", "")
    word = ("draft" if info.get("isDraft") else "open") if st == "OPEN" else st.lower()
    review = {"APPROVED": " ✓", "CHANGES_REQUESTED": " ✗"}.get(info.get("reviewDecision"), "") if st == "OPEN" else ""
    # Colored by what the PR needs from you, not GitHub's open/merged/closed colors.
    if st == "OPEN":
        color = DIM if info.get("isDraft") else {"APPROVED": GREEN, "CHANGES_REQUESTED": YELLOW}.get(
            info.get("reviewDecision"), "")
    else:
        color = {"MERGED": DIM + MAGENTA, "CLOSED": DIM + RED}.get(st, DIM)
    return ("#%s %s%s" % (pr["number"], word, review)).strip(), color


def app(s):
    if s.get("kind") == "background":
        return "bg"
    return "" if s.get("host", "warp") == "warp" else s["host"]


def fit(text, width):
    text = (text or "").replace("\t", " ").replace("\n", " ")
    return text[: width - 1] + "…" if len(text) > width else text.ljust(width)


def sort_key(s, prs):
    return (STATES[state(s, prs)][2], -(s.get("statusSince") or 0))


COLUMNS = "  %-10s %4s  %-42s %-15s %-9s %s"
SECTION_KINDS = ("divider", "batch", "closed")


def divider_line(label):
    """A rule across the list pane; fzf exports its width as FZF_COLUMNS to commands it runs."""
    try:
        cols = int(os.environ.get("FZF_COLUMNS") or os.get_terminal_size(sys.__stdout__.fileno()).columns)
    except (OSError, ValueError):
        cols = 160
    width = max(40, int(cols * 0.55) - 6)  # the list is ~55% of the screen, minus borders
    side = (width - len(label) - 2) // 2
    return "─" * side + " " + label + " " + "─" * (width - side - len(label) - 2)


PREFS = os.path.join(CACHE_DIR, "prefs.json")


def warp_only():
    return False if DEMO else load_json(PREFS, {}).get("warpOnly", False)


def visible(rows):
    """Drop sessions outside Warp tabs (remote, desktop, other apps, background) when ^t is on."""
    if not warp_only():
        return rows
    return [r for r in rows if r.get("kind") not in ("background", "interactive") or
            (r["kind"] == "interactive" and r.get("host") == "warp")]


def render(rows):
    rows = visible(rows)
    prs = pr_cache()
    now = time.time()
    out = ["key\t-\t" + DIM + COLUMNS % ("STATE", "AGE", "SESSION", "PR", "APP", "WHERE") + RESET]
    section = [r for r in rows if r.get("kind") in SECTION_KINDS]
    live = sorted((r for r in rows if r.get("kind") not in SECTION_KINDS), key=lambda r: sort_key(r, prs))
    for s in live + section:
        if s["kind"] == "divider":
            out.append("divider\tdivider\t" + DIM + divider_line("recently closed") + RESET)
            continue
        st = state(s, prs)
        icon, color, _ = STATES[st]
        icon = s.get("tree", icon)
        faded = st in ("stale", "done", "closed", "reopen all")
        pr_text, pr_color = pr_label(s, prs)
        line = "%s%s %s%s %4s  %s%s%s %s%s%s %s%s %s%s" % (
            color, icon, fit(st, 10), RESET,
            "" if st == "working" else age(now - (s.get("statusSince") or now)),
            DIM if faded else "", fit(title(s), 42), RESET,
            pr_color, fit(pr_text, 15), RESET,
            DIM, fit(app(s), 9),
            where(s), RESET,
        )
        out.append("%s\t%s\t%s" % (s["key"], s.get("kind", ""), line))
    return "\n".join(out)


def git(cwd, *args):
    r = subprocess.run(["git", "-C", cwd] + list(args), capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def diff_base(cwd):
    """Merge base with the repo's default branch, or None outside a git repo."""
    base = git(cwd, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or next(
        (b for b in ("origin/main", "origin/master") if git(cwd, "rev-parse", "--verify", "-q", b)), None)
    if not base:
        return None, None
    mb = git(cwd, "merge-base", base, "HEAD")
    return (base, mb) if mb else (None, None)


def git_summary(cwd):
    base, mb = diff_base(cwd)
    if not mb:
        return None
    ahead = git(cwd, "rev-list", "--count", mb + "..HEAD") or "0"
    stat = git(cwd, "diff", "--shortstat", mb) or "no changes"
    dirty = len((git(cwd, "status", "--porcelain") or "").splitlines())
    parts = ["%s commit%s ahead of %s" % (ahead, "" if ahead == "1" else "s", base), stat.strip()]
    if dirty:
        parts.append(YELLOW + "%d uncommitted" % dirty + RESET)
    return " · ".join(parts)


def cmd_diff(args):
    s = find(args[0])
    cwd = s.get("cwd") or HOME
    base, mb = diff_base(cwd)
    if not mb:
        return pause("%s isn't a git checkout" % cwd.replace(HOME, "~"))
    # Committed and uncommitted changes against the default branch; untracked files listed on top.
    pretty = " | diff-so-fancy" if shutil.which("diff-so-fancy") else ""
    cmd = "{{ git -C {cwd} status --short --untracked-files=all; echo; git -C {cwd} diff --color=always {mb}{pretty}; }} | less -R"
    subprocess.run(cmd.format(cwd=shlex.quote(cwd), mb=mb, pretty=pretty), shell=True)



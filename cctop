def post(sock_path, action):
    body = action.encode()
    req = b"POST / HTTP/1.1\r\nHost: fzf\r\nContent-Length: %d\r\n\r\n%s" % (len(body), body)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        s.connect(sock_path)
        s.sendall(req)
        s.recv(1024)



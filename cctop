def claim_reopen(session_ids):
    """Mark sessions as reopening; False if any already is (a repeated enter)."""
    now = time.time()
    pending = {k: v for k, v in load_json(REOPENING, {}).items() if now - v < REOPEN_GRACE}
    if any(sid in pending for sid in session_ids):
        return False
    pending.update({sid: now for sid in session_ids})
    save_json(REOPENING, pending)
    return True


def act_jump(s, me):
    if s.get("kind") == "batch":
        if not claim_reopen([m["sessionId"] for m in s["members"]]):
            return status("Already reopening these sessions", YELLOW)
        background(me, "reopen-all", repr(s["batch"]))
        return status("Reopening %d sessions in new tabs" % len(s["members"]), GREEN)
    if s.get("kind") == "closed":
        if not claim_reopen([s["sessionId"]]):
            return status("Already reopening “%s”" % title(s), YELLOW)
        # Opening a tab waits for Warp to index the config, so do it in the background.
        background(me, "reopen", s["sessionId"], resume_dir(s), title(s))
        return status("Reopening “%s” in a new tab" % title(s), GREEN)
    if s.get("kind") == "background":
        return "execute(%s attach %s)" % (me, s["key"])
    if s.get("host") == "remote":
        return status("“%s” is a remote session: open it from claude.ai/code or the Claude app" % title(s), YELLOW)
    url = focus_url(s["pid"])
    if not url:
        return status("“%s” isn't in a Warp tab (it runs in %s)" % (title(s), s.get("host", "another app")), YELLOW)
    subprocess.run(["open", url])
    return ""



def toml_str(value):
    """A TOML basic string. JSON escaping matches TOML's except that ensure_ascii would write
    emoji as surrogate pairs, which TOML rejects; control characters are dropped outright."""
    return json.dumps("".join(c for c in value if c >= " " and c != "\x7f"), ensure_ascii=False)


def write_tab_config(session_id, cwd, name, command=None, config=None):
    """A throwaway Warp tab config that runs Claude in a new tab (the mechanism /spawn-session
    uses); by default it resumes the given session."""
    os.makedirs(TAB_CONFIGS, exist_ok=True)
    config = config or "cctop-resume-%s" % session_id
    with open(os.path.join(TAB_CONFIGS, config + ".toml"), "w") as f:
        f.write('name = %s\n\n[[panes]]\nid = "main"\ntype = "terminal"\ndirectory = %s\ncommands = [%s]\n'
                % (toml_str("claude: " + name), toml_str(cwd), toml_str(command or "claude -r " + session_id)))
    return config


def open_tab_configs(configs):
    time.sleep(1)  # let Warp's file watcher index the configs before the URIs ask for them
    for config in configs:
        subprocess.run(["open", "warp://tab_config/" + config])
        time.sleep(0.5)  # keep the tabs in order
    time.sleep(15)
    for config in configs:
        try:
            os.unlink(os.path.join(TAB_CONFIGS, config + ".toml"))
        except OSError:
            pass



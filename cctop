FZF_MIN = (0, 71)  # --id-nth, which keeps the cursor on the same session across refreshes


def check_requirements():
    problems = []
    if sys.platform != "darwin":
        problems.append("cctop only runs on macOS")
    if not shutil.which("claude"):
        problems.append("the Claude Code CLI (claude) isn't on your PATH")
    fzf = shutil.which("fzf")
    if not fzf:
        problems.append("fzf isn't installed (brew install fzf)")
    else:
        out = subprocess.run([fzf, "--version"], capture_output=True, text=True).stdout
        version = tuple(int(n) for n in out.split()[0].split(".")[:2]) if out else (0, 0)
        if version < FZF_MIN:
            problems.append("fzf %s or newer is needed, found %s (brew upgrade fzf)"
                            % (".".join(map(str, FZF_MIN)), out.split()[0] if out else "unknown"))
    if not os.environ.get("WARP_FOCUS_URL"):
        print("cctop: not running in Warp; jumping to tabs, closing tabs and reopening won't work",
              file=sys.stderr)
    if problems:
        sys.exit("cctop: " + "; ".join(problems))


def cmd_ui(_):
    check_requirements()
    me = os.path.realpath(sys.argv[0])
    sock = os.path.join(tempfile.gettempdir(), "cctop-%d.sock" % os.getpid())
    os.environ["CCTOP_UI"] = str(os.getpid())
    os.environ["CCTOP_HOME"] = os.getcwd()  # default folder for ^n
    stop = threading.Event()

    listing = listing_path()
    # Per-view files from views that were killed rather than quit.
    for path in glob.glob(os.path.join(CACHE_DIR, "*-[0-9]*.*")):
        owner = os.path.basename(path).split("-", 1)[1].split(".")[0]
        if owner.isdigit() and not alive(int(owner)):
            os.unlink(path)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))

    def ticker():
        # Collect off fzf's thread and only reload when the rendered list changed; the reload itself
        # is then just a `cat`, so fzf is never left waiting on a slow command while you type.
        last_pr, last_text = 0, initial_text
        while not stop.wait(REFRESH_SECONDS):
            try:
                rows = collect()
                track_ended(rows)
                save_json(snapshot_path(), {"at": time.time(), "rows": rows})
                text = render(rows)
                if text != last_text:
                    with open(listing, "w") as f:
                        f.write(text + "\n")
                    post(sock, "reload-sync(cat %s)+refresh-preview+change-list-label:%s"
                         % (shlex.quote(listing), list_label(rows)))
                    last_text = text
                if time.time() - last_pr > PR_REFRESH_SECONDS:
                    last_pr = time.time()
                    threading.Thread(target=refresh_prs, args=(rows,), daemon=True).start()
            except Exception:
                # Keep ticking; a missed refresh is harmless. Log it for debugging.
                import traceback
                with open(os.path.join(CACHE_DIR, "errors.log"), "a") as f:
                    f.write(time.strftime("%H:%M:%S ") + traceback.format_exc())

    # Build the first list here, where the terminal size is known (fzf's own start-up command can't
    # see it, so the divider would be drawn at a guessed width until the first refresh).
    try:
        rows = collect()
    except AgentsUnavailable:
        rows = []
    initial_text = render(rows)
    with open(listing, "w") as f:
        f.write(initial_text + "\n")
    threading.Thread(target=ticker, daemon=True).start()
    set_tab_title("/dev/tty", "cctop")
    try:
        subprocess.run([
            "fzf", "--color=bg+:#1f4060,pointer:#66d9ef", "--pointer=▌", "--ansi", "--delimiter=\t", "--with-nth=3..", "--id-nth=1", "--track",
            "--no-sort", "--layout=reverse", "--no-multi", "--listen=" + sock,
            "--prompt=" + PROMPT, "--info=inline-right", "--input-border=rounded",
            "--list-border=rounded", "--list-label=" + list_label(rows), "--highlight-line",
            "--header-lines=1", "--header-lines-border=bottom",
            "--footer=" + footer(), "--footer-border=none",
            "--preview=%s preview {1}" % me, "--preview-window=right,45%,wrap,border-rounded",
            "--bind=start:reload-sync(cat %s)" % shlex.quote(listing),
            "--bind=enter:transform(%s act jump {1})" % me,
            "--bind=ctrl-o:execute-silent(%s open-pr {1})" % me,
            "--bind=ctrl-e:execute-silent(%s code {1})" % me,
            "--bind=ctrl-d:transform(%s act diff {1})" % me,
            "--bind=ctrl-x:transform(%s act close {1})" % me,
            "--bind=ctrl-r:reload-sync(%s list)+refresh-preview" % me,
            "--bind=ctrl-t:transform(%s act filter {1})" % me,
            "--bind=ctrl-n:transform(%s act new {1})" % me,
            "--bind=ctrl-p:ignore",  # fzf's default "up"; its pair ^n now starts a session
            "--bind=ctrl-g:ignore",  # fzf's default quits; too easy to hit by accident
            "--bind=esc:clear-query",
        ] + [
            "--bind=?,ctrl-/:change-preview(%s help)+change-preview-label( help )" % me,
            "--bind=focus:change-preview(%s preview {1})+change-preview-label()" % me,
        ] + [
            # Step over the "recently closed" divider: move again if the move landed on it.
            "--bind=%s:%s+transform([ {1} = divider ] && echo %s || true)" % (key, move, move)
            for keys, move in (("down,ctrl-j", "down"), ("up,ctrl-k", "up"))
            for key in keys.split(",")
        ], stdin=subprocess.DEVNULL)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        stop.set()
        for path in (sock, snapshot_path(), listing):
            if os.path.exists(path):
                os.unlink(path)



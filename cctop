def refresh_prs(rows):
    if DEMO:
        return
    urls = {r["pr"]["url"] for r in rows if r.get("pr") and r["pr"].get("url")}
    if not urls or not shutil.which("gh"):
        return
    prs = pr_cache()

    def fetch(url):
        try:
            out = subprocess.run(["gh", "pr", "view", url, "--json", "state,isDraft,reviewDecision,title"],
                                 capture_output=True, text=True, timeout=20).stdout
            return url, json.loads(out)
        except (OSError, ValueError, subprocess.TimeoutExpired):
